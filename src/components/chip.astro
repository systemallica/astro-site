---
import type { IconDefinition } from "@fortawesome/fontawesome-svg-core";
import Icon from "./icon.astro";

interface Props {
  link: string;
  icon: IconDefinition;
  label: string;
}
const { link, icon, label } = Astro.props;
---

<a
  class="text-3xl"
  aria-label={label}
  target="_blank"
  rel="noreferrer"
  href={link}
>
  <Icon icon={icon} />
</a>

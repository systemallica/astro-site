---
import { icon, type IconDefinition } from "@fortawesome/fontawesome-svg-core";

interface Props {
  icon: IconDefinition;
}

const { icon: definition } = Astro.props;
const svg = icon(definition, {
  attributes: {
    "aria-hidden": "true",
    focusable: "false",
    style: "width: 1em; height: 1em; vertical-align: -0.125em;",
  },
}).html.join("");
---

<Fragment set:html={svg} />
